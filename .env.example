# Set to the NAS LAN IP for LAN access; defaults to loopback only.
ROYALBOOKS_BIND_IP=127.0.0.1
ROYALBOOKS_PORT=8094
ROYALBOOKS_DATA_PATH=./data
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving blank disables book acquisition operations.
ROYALBOOKS_API_TOKEN=
# Optional comma-separated peer CIDRs with automatic management access.
# Use only on a private deployment; forwarded headers are ignored.
ROYALBOOKS_TRUSTED_NETWORKS=
# BookOrbit owns the library; no Calibre/CWA mounts are used.
ROYALBOOKS_LIBRARY_BACKEND=bookorbit
# Use a reachable address. bookorbit-app:3000 requires a shared Docker network.
ROYALBOOKS_BOOKORBIT_URL=http://192.168.178.47:3100
ROYALBOOKS_BOOKORBIT_PUBLIC_URL=http://192.168.178.47:3100
# HOST paths; leave ingest blank for staging-only operation.
ROYALBOOKS_BOOKORBIT_INGEST_PATH=
ROYALBOOKS_BOOKORBIT_LIBRARY_PATH=/volume2/bookorbit-books
ROYALBOOKS_BOOKORBIT_GID=1000
ROYALBOOKS_SECRETS_PATH=./secrets
# Create secrets/bookorbit.env with BOOKORBIT_USERNAME and BOOKORBIT_PASSWORD.
# File owner UID 10001, mode 0400/0600; never commit it.
ROYALBOOKS_BOOKORBIT_VERIFY_IMPORT=0
# Optional: Google Books metadata. Requires an API key; no key = provider disabled.
GOOGLE_BOOKS_API_KEY=
# DNB (German National Library) bibliographic search is enabled by default.
# DNB supplies metadata only, never EPUB downloads.
ROYALBOOKS_DNB_ENABLED=1

# Optional, read-only book indexer discovery.
# Set an operator-managed Prowlarr server reachable from the container.
ROYALBOOKS_PROWLARR_URL=
ROYALBOOKS_PROWLARR_API_KEY=
# Additional custom Newznab/Torznab servers: data/indexers.json
# Historical Gutenberg download worker paused by default; existing records preserved.
ROYALBOOKS_ENABLE_LEGACY_WORKER=0
